# Copy to scripts/.env (gitignored). Every value except SEPOLIA_RPC_URL and EVM_PRIVATE_KEY has a default.
SOLANA_RPC_URL=https://api.devnet.solana.com
SEPOLIA_RPC_URL=
# Solana keypair file used to sign (default ~/.config/solana/id.json)
SOLANA_KEYPAIR=
# EVM key for sends from Sepolia (hex, with 0x)
EVM_PRIVATE_KEY=
# Override to use your own deployment of the example programs
SENDER_PROGRAM=
RECEIVER_PROGRAM=
PING_PONG_PROGRAM=
